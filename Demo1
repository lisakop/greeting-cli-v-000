      "source": [
        "import numpy as np\n",
        "from scipy.integrate import solve_ivp\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Define a time-varying free ligand concentration L(t) - Normal Cholesterol\n",
        "# In this example, we model a transient pulse of cholesterol (e.g., following a meal or injection)\n",
        "def L_dynamic(t):\n",
        "    # A baseline of 0.5 nM, with a peak of 8 nM centered at t = 30s with a width of 10s\n",
        "    baseline = 0.5\n",
        "    peak_amplitude = 7.5\n",
        "    mean_t = 30.0\n",
        "    std_dev = 10.0\n",
        "    return baseline + peak_amplitude * np.exp(-((t - mean_t) ** 2) / (2 * (std_dev ** 2)))\n",
        "\n",
        "# Define the ODE system where ligand concentration L(t) is time-dependent\n",
        "def dynamic_binding_system(t, y, k_on, k_off):\n",
        "    R, LR = y\n",
        "    L = L_dynamic(t)\n",
        "\n",
        "    # d[LR]/dt = k_on * L(t) * [R] - k_off * [LR]\n",
        "    dLR_dt = k_on * L * R - k_off * LR\n",
        "\n",
        "    # Since total receptor is conserved: [R]_total = [R] + [LR], d[R]/dt = -d[LR]/dt\n",
        "    dR_dt = -dLR_dt\n",
        "\n",
        "    return [dR_dt, dLR_dt]\n",
        "\n",
        "# Constants\n",
        "k_on = 0.1   # nM⁻¹s⁻¹\n",
        "k_off = 0.05 # s⁻¹\n",
        "\n",
        "# Initial conditions: [R_0, LR_0]\n",
        "# Assume we start with 5 nM of free receptors and 0 complex\n",
        "y0 = [5.0, 0.0]\n",
        "\n",
        "# Time span for the simulation\n",
        "t_span = (0, 100)\n",
        "t_eval = np.linspace(t_span[0], t_span[1], 1000)\n",
        "\n",
        "# Solve the ODEs\n",
        "sol = solve_ivp(dynamic_binding_system, t_span, y0, args=(k_on, k_off), t_eval=t_eval)\n",
        "\n",
        "# Calculate the corresponding ligand concentration at each time step for plotting\n",
        "L_values = L_dynamic(sol.t)\n",
        "# Calculate fractional occupancy (theta = [LR]/[R_total])\n",
        "R_total = y0[0] + y0[1]\n",
        "theta = sol.y[1] / R_total\n",
        "\n",
        "# Plot the results\n",
        "fig, ax1 = plt.subplots(figsize=(11, 7))\n",
        "\n",
        "# Plot concentrations on the left y-axis\n",
        "color = 'tab:blue'\n",
        "ax1.set_xlabel('Time (s)')\n",
        "ax1.set_ylabel('Concentration (nM)', color=color)\n",
        "line1 = ax1.plot(sol.t, L_values, label='Dynamic Ligand [L](t)', color='blue', linestyle='--', linewidth=2)\n",
        "line2 = ax1.plot(sol.t, sol.y[0], label='Free Receptor [R]', color='orange', linewidth=2)\n",
        "line3 = ax1.plot(sol.t, sol.y[1], label='Complex [LR]', color='green', linewidth=2)\n",
        "ax1.tick_params(axis='y', labelcolor=color)\n",
        "ax1.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "# Create a second y-axis for fractional occupancy\n",
        "ax2 = ax1.twinx()\n",
        "color = 'tab:purple'\n",
        "ax2.set_ylabel('Fractional Occupancy (θ)', color=color)\n",
        "line4 = ax2.plot(sol.t, theta, label='Occupancy (θ)', color='purple', linewidth=2.5)\n",
        "ax2.tick_params(axis='y', labelcolor=color)\n",
        "ax2.set_ylim(0, 1.05)\n",
        "\n",
        "# Combined legends\n",
        "lines = line1 + line2 + line3 + line4\n",
        "labels = [l.get_label() for l in lines]\n",
        "ax1.legend(lines, labels, loc='upper right')\n",
        "\n",
        "plt.title('Binding Kinetics with Time-Varying Ligand Concentration')\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
