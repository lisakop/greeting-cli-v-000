      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Calculate Kd from existing rate constants\n",
        "Kd = k_off / k_on # 0.05 / 0.1 = 0.5 nM\n",
        "\n",
        "# Generate a range of free ligand (cholesterol) concentrations [L]\n",
        "free_ligand = np.linspace(0, 10, 1000) # from 0 to 10 nM\n",
        "\n",
        "# Calculate fractional occupancy (theta)\n",
        "occupancy = free_ligand / (free_ligand + Kd)\n",
        "\n",
        "# Plotting the saturation curve\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(free_ligand, occupancy, color='purple', linewidth=2.5, label='Occupancy Curve')\n",
