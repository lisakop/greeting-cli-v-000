      "source": [
        "import numpy as np\n",
        "from scipy.integrate import solve_ivp\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# This is part of Section 1 for Demo 1 (Initial Physiological Model): Define the ODE system for reversible binding\n",
        "def binding_dynamics(t, y, k_on, k_off):\n",
        "    L, R, LR = y\n",
        "    # d[LR]/dt = k_on * L * R - k_off * LR\n",
        "    dLR_dt = k_on * L * R - k_off * LR\n",
        "    # Conservation laws apply: d[L]/dt = -d[LR]/dt, d[R]/dt = -d[LR]/dt\n",
        "    dL_dt = -dLR_dt\n",
        "    dR_dt = -dLR_dt\n",
        "    return [dL_dt, dR_dt, dLR_dt]\n",
        "\n",
        "# Rate constants\n",
        "k_on = 0.1   # Association rate (e.g., 1/(nM * s))\n",
        "k_off = 0.05 # Dissociation rate (e.g., 1/s)\n",
        "\n",
        "# Initial conditions: [L_0, R_0, LR_0]\n",
        "# Let's assume initial free cholesterol is 10 nM, free receptor is 5 nM, and no complex formed\n",
        "y0 = [10.0, 5.0, 0.0]\n",
        "\n",
        "# Time span for simulation (0 to 100 seconds)\n",
        "t_span = (0, 100)\n",
        "t_eval = np.linspace(t_span[0], t_span[1], 1000)\n",
        "\n",
        "# Solve the ODEs\n",
        "sol = solve_ivp(binding_dynamics, t_span, y0, args=(k_on, k_off), t_eval=t_eval)\n",
        "\n",
        "# Plot the results\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(sol.t, sol.y[0], label='Free Cholesterol [L]', linewidth=2)\n",
        "plt.plot(sol.t, sol.y[1], label='Free Receptor [R]', linewidth=2)\n",
        "plt.plot(sol.t, sol.y[2], label='Cholesterol-Receptor Complex [LR]', linewidth=2)\n",
        "plt.title('Reversible Cholesterol-Receptor Binding Kinetics')\n",
        "plt.xlabel('Time (s)')\n",
        "plt.ylabel('Concentration (nM)')\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "plt.legend()\n",
        "plt.show()"
      ],
